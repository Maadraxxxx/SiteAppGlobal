EXPO_PUBLIC_API_URL=http://localhost:3333/api

# Reservado para a etapa de pagamento — nenhum código lê isso ainda.
# Apenas a chave PUBLICA do Mercado Pago pode ir aqui (prefixo EXPO_PUBLIC_
# expõe o valor no bundle do cliente); o access token fica só no backend.
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Endereco publico do site, usado no link do botao "compartilhar" quando o app
# roda no celular. Na web o link sai da propria pagina.
EXPO_PUBLIC_SITE_URL=
