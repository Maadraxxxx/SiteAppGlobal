{
  "expo": {
    "name": "Global Decora",
    "slug": "global-decora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "globaldecora",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.globaldecora.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FA4F17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A equipe da loja usa as fotos do aparelho para cadastrar as imagens dos produtos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "medinaiv",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c2bc957-6b2e-43c1-a0a8-704cb6ac3694"
      }
    }
  }
}
