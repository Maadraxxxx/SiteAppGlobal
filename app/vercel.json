{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/produto/:id", "destination": "/produto/[id].html" },
    { "source": "/pedido/:id", "destination": "/pedido/[id].html" },
    { "source": "/pagamento/:id", "destination": "/pagamento/[id].html" },
    { "source": "/rastreio/:id", "destination": "/rastreio/[id].html" },
    { "source": "/suporte/:id", "destination": "/suporte/[id].html" },
    { "source": "/admin/produtos/:id", "destination": "/admin/produtos/[id].html" },
    { "source": "/admin/chamados/:id", "destination": "/admin/chamados/[id].html" },
    { "source": "/admin/etiqueta/:id", "destination": "/admin/etiqueta/[id].html" },
    { "source": "/:path*", "destination": "/+not-found.html" }
  ]
}
