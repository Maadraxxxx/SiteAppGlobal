DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/dbname

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
API_PORT=3333

SEED_ADMIN_EMAIL=admin@globaldecora.com
SEED_ADMIN_PASSWORD=changeme123
SEED_CLIENTE_EMAIL=cliente@example.com
SEED_CLIENTE_PASSWORD=changeme123

# Usado pro upload de imagem de produto (Supabase Storage) — pegue em
# Project Settings > API Keys > service_role (Project Settings > Data API
# tem a URL). Sem prefixo SUPABASE_ porque a Vercel reserva esse prefixo
# pra integração própria dela.
SUPA_URL=https://xxxxx.supabase.co
SUPA_SERVICE_ROLE_KEY=

# Reservado para as próximas etapas (gerador de IA e pagamento) — nenhum
# código lê essas variáveis ainda.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-1
