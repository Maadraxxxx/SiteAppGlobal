generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENTE
  ADMIN
}

enum TamanhoKit {
  P
  M
  G
}

enum StatusKit {
  RASCUNHO
  AGUARDANDO_PAGAMENTO
  CONFIRMADO
}

/// Dinheiro. Anda sozinho: quem mexe aqui e o retorno do Mercado Pago, nao a
/// bancada. CANCELADO cobre tanto o pedido abandonado quanto o estornado.
enum StatusPagamentoPedido {
  AGUARDANDO
  PAGO
  CANCELADO
}

/// Bancada e entrega. Anda sozinho tambem: um pedido pode estar pago e ainda
/// nem ter entrado na producao, ou ja ter sido enviado.
enum StatusProducao {
  AGUARDANDO
  EM_PRODUCAO
  ENVIADO
  ENTREGUE
}

enum TipoItemPedido {
  PRODUTO
  KIT_CUSTOMIZADO
}

enum MetodoPagamento {
  PIX
  CARTAO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
  ESTORNADO
}

model Usuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  // Nulo em conta criada pelo Google: nunca houve senha pra guardar.
  senhaHash  String?
  // Identificador do Google (claim 'sub'), pra reconhecer a conta mesmo se o
  // cliente trocar o e-mail depois.
  googleId   String?  @unique
  avatarUrl  String?
  role       Role     @default(CLIENTE)
  // Geracoes de imagem compradas e ainda nao usadas (alem das gratuitas do dia)
  creditosIA Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pedidos          Pedido[]
  kitsCustomizados KitCustomizado[]
  enderecos        Endereco[]
  geracoesIA       GeracaoImagem[]
  comprasCreditoIA CompraCreditoIA[]

  @@map("usuarios")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  descricao String?

  /// Ganha uma vitrine propria na tela inicial, com os produtos dela em
  /// carrossel — do mesmo jeito que os Destaques. Quem escolhe e o admin.
  naHome Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[]

  @@map("categorias")
}

model Formato {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos         Produto[]
  kitsCustomizados KitCustomizado[]

  @@map("formatos")
}

model Estilo {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos         Produto[]
  kitsCustomizados KitCustomizado[]

  @@map("estilos")
}

model Banner {
  id        String   @id @default(uuid())
  imagemUrl String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Produto {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  preco       Decimal  @db.Decimal(10, 2)
  comprimento Decimal? @db.Decimal(10, 2) // cm
  largura     Decimal? @db.Decimal(10, 2) // cm
  altura      Decimal? @db.Decimal(10, 2) // cm
  peso        Decimal? @db.Decimal(10, 3) // kg
  imagemUrl   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  formatoId String
  formato   Formato @relation(fields: [formatoId], references: [id])

  estiloId String
  estilo   Estilo @relation(fields: [estiloId], references: [id])

  itensPedido ItemPedido[]
  geracoesIA  GeracaoImagem[]

  @@index([categoriaId])
  @@index([formatoId])
  @@index([estiloId])
  @@map("produtos")
}

model Endereco {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  apelido     String? // "Casa", "Trabalho"
  /// CPF/CNPJ do destinatario — as transportadoras exigem pra emitir etiqueta.
  documento   String?
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String  @db.VarChar(2)

  // o endereco marcado vem selecionado por padrao no checkout
  principal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("enderecos")
}

/// Uma imagem gerada pela IA. Serve de historico e de base pra contagem diaria.
model GeracaoImagem {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  tema      String
  imagemUrl String
  // false = saiu da cota gratuita do dia; true = consumiu um credito comprado
  paga      Boolean @default(false)

  createdAt DateTime @default(now())

  itensPedido ItemPedido[]

  @@index([usuarioId, createdAt])
  @@map("geracoes_imagem")
}

/// Compra de creditos de geracao, paga por PIX.
model CompraCreditoIA {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  quantidade Int
  valor      Decimal         @db.Decimal(10, 2)
  status     StatusPagamento @default(PENDENTE)

  mercadoPagoPaymentId String? @unique
  qrCodeBase64         String? @db.Text
  qrCodeCopiaCola      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("compras_credito_ia")
}

model KitCustomizado {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  formatoId String
  formato   Formato @relation(fields: [formatoId], references: [id])

  // reaproveita a tabela de estilos como registro de "temas" (ver AI prompt doc §2:
  // {{tema}} vem de "tag cadastrada pelo admin", mesma origem do estilo/tema do catálogo)
  temaId String
  tema   Estilo @relation(fields: [temaId], references: [id])

  cores        String
  estiloVisual String? // livre: fofo/infantil, elegante, dark, minimalista...
  tipoEvento   String?
  observacoes  String?

  imagemGeradaUrl String?
  tamanho         TamanhoKit?
  preco           Decimal?    @db.Decimal(10, 2)
  status          StatusKit   @default(RASCUNHO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemPedido ItemPedido?

  @@map("kits_customizados")
}

model Pedido {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // Dois eixos independentes: um pedido pago pode estar em producao, enviado
  // ou ainda parado na fila. Antes era um status so, e um excluia o outro.
  statusPagamento StatusPagamentoPedido @default(AGUARDANDO)
  statusProducao  StatusProducao        @default(AGUARDANDO)

  // total = subtotal dos itens + frete; guardamos os dois pra nota e conferencia
  subtotal  Decimal  @default(0) @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Frete escolhido no carrinho (Melhor Envio). Nulo em pedido feito antes
  // de existir calculo de frete, ou em retirada.
  cepDestino          String?
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  freteValor          Decimal? @db.Decimal(10, 2)
  freteServico        String? // ex: "PAC", "SEDEX", "Jadlog .Package"
  freteTransportadora String?
  fretePrazoDias      Int?

  /// Preenchido ao gerar a etiqueta no Melhor Envio, ou colado a mao pelo admin
  /// quando o envio e feito por fora (balcao dos Correios, por exemplo).
  codigoRastreio     String?
  urlEtiqueta        String?
  /// id do envio no Melhor Envio, usado pra consultar o rastreio deles
  melhorEnvioEnvioId String?

  itens      ItemPedido[]
  pagamentos Pagamento[]

  @@map("pedidos")
}

model ItemPedido {
  id       String         @id @default(uuid())
  pedidoId String
  pedido   Pedido         @relation(fields: [pedidoId], references: [id])
  tipo     TipoItemPedido

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  kitCustomizadoId String?         @unique
  kitCustomizado   KitCustomizado? @relation(fields: [kitCustomizadoId], references: [id])

  quantidade    Int     @default(1)
  precoUnitario Decimal @db.Decimal(10, 2)

  /// Quando o cliente encomenda a versao personalizada pela IA. O preco segue
  /// o do produto original; muda so a arte a ser produzida.
  geracaoImagemId String?
  geracaoImagem   GeracaoImagem? @relation(fields: [geracaoImagemId], references: [id])

  @@map("itens_do_pedido")
}

model Pagamento {
  id       String @id @default(uuid())
  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  metodo MetodoPagamento
  status StatusPagamento @default(PENDENTE)
  valor  Decimal         @db.Decimal(10, 2)

  mercadoPagoPaymentId String? @unique
  qrCodeBase64         String? @db.Text
  qrCodeCopiaCola      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pagamentos")
}
