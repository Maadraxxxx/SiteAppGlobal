{
  "name": "global-decora",
  "private": true,
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,app -c blue,magenta \"npm run dev -w server\" \"npm run start -w app\"",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  }
}
