{
  "name": "global-decora",
  "private": true,
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,app -c blue,magenta \"npm run dev -w server\" \"npm run start -w app\"",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true
  }
}
